# Copy to .env  (the file must be named exactly ".env")

# --- Live trading only (leave blank for read_only / paper) -------------------
# Polygon private key of the wallet that signs orders. Never commit this.
PM_PRIVATE_KEY=

# Address that holds the pUSD collateral and receives tokens.
# For a plain EOA wallet this is the same address as the private key.
# For a Polymarket-created wallet (proxy / safe) it is the proxy address shown in the UI.
PM_FUNDER=

# 0 = EOA, 1 = Polymarket proxy wallet, 2 = Gnosis safe (Polymarket-created wallets are usually 2)
PM_SIGNATURE_TYPE=0

# CLOB API credentials. If blank they are derived from the private key on first run and printed.
PM_CLOB_API_KEY=
PM_CLOB_API_SECRET=
PM_CLOB_API_PASSPHRASE=

# Belt-and-braces: live mode refuses to start unless this is exactly "yes".
LIVE_TRADING=no

# --- Polymarket US (venue: polymarket_us). Create keys at polymarket.us/developer ---
PM_US_KEY_ID=
PM_US_SECRET_KEY=

# --- Optional Telegram alerts (start, stop, kill switch, feed down, daily-loss halt, fills) ---
# Create a bot with @BotFather, message it once, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
PM_TELEGRAM_BOT_TOKEN=
PM_TELEGRAM_CHAT_ID=
